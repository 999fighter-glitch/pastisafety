rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'muhaiminzeeismail@gmail.com'; }

    match /pastis/{pastiId} {
      allow read, write: if true; 
      
      match /safetyChecks/{checkId} {
        allow read, write: if true;
      }
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }
    
    match /visitorLogs/{docId} {
      allow read, write: if true;
    }

    match /activeViewers/{sessionId} {
      allow read, write: if true;
    }
    
    match /siteStats/{docId} {
      allow read, write: if true;
    }

    match /adminNotifications/{notificationId} {
      allow read, write: if true;
    }

    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
